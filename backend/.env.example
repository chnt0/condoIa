# ============================================================
# Variables de entorno requeridas para producción
# Copiar este archivo como .env y completar los valores
# NUNCA subir el .env al repositorio (está en .gitignore)
# ============================================================

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/condos_db
DB_USERNAME=condos_user
DB_PASSWORD=password-seguro-aqui

# --- JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET=genera-un-secreto-de-al-menos-32-caracteres-aqui
JWT_ACCESS_EXPIRATION=3600000     # 1 hora en ms
JWT_REFRESH_EXPIRATION=86400000   # 24 horas en ms

# --- CORS ---
# URLs de la app móvil compilada (para web) o del panel de admin
# Para apps nativas (iOS/Android) no necesitas CORS — déjalo vacío o con solo el panel admin
CORS_ORIGINS=https://admin.tu-dominio.com

# --- Servidor ---
SERVER_PORT=8080

# --- Perfil Spring ---
SPRING_PROFILES_ACTIVE=prod
